# MCPサーバーポート
PORT=3020
# MCPエンドポイント
MCP_PATH=/mcp
# リソースサーバーURL
RESOURCE_SERVER_URL=http://localhost:3020/mcp
# Keycloak: issuer URL
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/mcp-demo
# Keycloak: introspection endpoint
KEYCLOAK_INTROSPECTION_ENDPOINT=http://localhost:8080/realms/mcp-demo/protocol/openid-connect/token/introspect
# Keycloak: client_id for introspection
OAUTH_CLIENT_ID=mcp-server
# Keycloak: client_secret for introspection
OAUTH_CLIENT_SECRET=mcp-server-secret
# Keycloak: required scope for introspection
REQUIRED_SCOPE=mcp:tools
# Keycloak: strict audience validation
OAUTH_STRICT=true
